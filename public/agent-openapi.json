          },
          "published": {
            "type": "boolean",
            "description": "false снимает публикацию и очищает расписание; true публикует сейчас либо в publishedAt."
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "ISO 8601 с часовым поясом. Будущая дата планирует публикацию вместе с published:true."
