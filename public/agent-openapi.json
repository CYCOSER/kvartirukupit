{
  "openapi": "3.0.3",
  "info": {
    "title": "Квартирукупить — API для ИИ-агента",
    "version": "1.1.0",
    "description": "Редактирование статей блога, обложек, описаний и значков существующих объектов; управление тегами и их назначением. Все операции требуют Bearer-токен. HTTPS обязателен при удалённом подключении. JSON-тело до 256 КиБ, Content-Length обязателен. Не изменяет цены, заявки или CRM."
  },
  "servers": [
    {
      "url": "/api/agent/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/articles": {
      "get": {
        "operationId": "listArticles",
        "summary": "Найти статьи и черновики",
        "description": "q ищет по заголовку и slug. Полный content возвращается при чтении статьи по id. Неизвестные параметры отклоняются.",
        "parameters": [
          {
            "$ref": "#/components/parameters/limit"
          },
          {
            "$ref": "#/components/parameters/offset"
          },
          {
            "$ref": "#/components/parameters/q"
          },
          {
            "$ref": "#/components/parameters/slug"
          },
          {
            "$ref": "#/components/parameters/published"
          }
        ],
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticlePage"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "createArticle",
        "summary": "Создать статью",
        "description": "По умолчанию создаётся черновик. После сетевого сбоя проверяйте результат по уникальному slug перед повтором POST.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ArticleCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Article"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/articles/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Идентификатор из ответа API, не slug",
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ],
      "get": {
        "operationId": "getArticle",
        "summary": "Прочитать статью целиком",
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Article"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "patch": {
        "operationId": "patchArticle",
        "summary": "Изменить поля статьи",
        "description": "Непереданные поля, включая расписание, сохраняются. Неизвестные поля и пустой объект отклоняются. published:false очищает расписание; published:true с будущим publishedAt планирует публикацию. publishedAt:null отменяет расписание черновика, у опубликованной статьи сохраняет прежнюю дату. Конфликт между внутренним чтением и записью возвращает 409; API не требует версию прочитанной клиентом записи.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ArticlePatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Article"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "delete": {
        "operationId": "deleteArticle",
        "summary": "Удалить статью без корзины",
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ok"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/articles/{id}/image": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Идентификатор из ответа API, не slug",
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ],
      "post": {
        "operationId": "uploadArticleImage",
        "summary": "Загрузить или заменить обложку",
        "description": "JPEG, PNG или WebP до 10 МиБ; multipart-запрос целиком до 12 МиБ. Сохраняется WebP. Content-Length обязателен.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "JPEG, PNG или WebP, не более 10 МиБ"
                  }
                }
              },
              "encoding": {
                "file": {
                  "contentType": "image/jpeg, image/png, image/webp"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticleImage"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "delete": {
        "operationId": "deleteArticleImage",
        "summary": "Удалить обложку",
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ok"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/properties": {
      "get": {
        "operationId": "listProperties",
        "summary": "Найти объекты",
        "description": "q ищет по заголовку, населённому пункту и адресу. Неизвестные параметры отклоняются.",
        "parameters": [
          {
            "$ref": "#/components/parameters/limit"
          },
          {
            "$ref": "#/components/parameters/offset"
          },
          {
            "$ref": "#/components/parameters/q"
          },
          {
            "$ref": "#/components/parameters/published"
          },
          {
            "name": "slug",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 120,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "complex",
                "apartment"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PropertyPage"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/properties/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Идентификатор из ответа API, не slug",
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ],
      "get": {
        "operationId": "getProperty",
        "summary": "Прочитать описание и характеристики объекта",
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Property"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/property-features": {
      "get": {
        "operationId": "listPropertyFeatures",
        "summary": "Справочник значков",
        "description": "Массив без пагинации, отсортированный по группе и названию.",
        "responses": {
          "200": { "description": "Справочник", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/PropertyFeature" } } } } },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/properties/{id}/features": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } }],
      "patch": {
        "operationId": "setPropertyFeatures",
        "summary": "Изменить значки объекта",
        "description": "Непереданные поля сохраняются; переданные массивы заменяются целиком, [] очищает поле. Сохраняйте прежние ID при добавлении. Для каждого значка его группа должна входить в featureOverrides. Не более одного значка отопления. Группа с override без значков явно очищена; без override допускается наследование от ЖК. Связанные теги синхронизируются атомарно, обычные теги сохраняются. На вторичном рынке значки не отображаются.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PropertyFeaturesPatch" } } } },
        "responses": {
          "200": { "description": "Актуальный объект", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Property" } } } },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/tags": {
      "get": {
        "operationId": "listTags",
        "summary": "Справочник тегов и связанных значков",
        "description": "Массив без пагинации, отсортированный по имени.",
        "responses": {
          "200": { "description": "Теги", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Tag" } } } } },
          "default": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "operationId": "createTag",
        "summary": "Создать тег, при необходимости со значком",
        "description": "propertyFeature создаёт связанный значок; null или отсутствие поля создаёт обычный тег. Конфликт уникального имени возвращает 409.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TagCreate" } } } },
        "responses": {
          "200": { "description": "Созданный тег", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Tag" } } } },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/tags/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } }],
      "put": {
        "operationId": "updateTag",
        "summary": "Переименовать тег и связанный значок",
        "description": "name обязателен. Тип тега и группу значка менять нельзя. Отсутствие propertyFeature сохраняет значок; null допустим только для обычного тега. Конфликт уникального имени возвращает 409.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TagUpdate" } } } },
        "responses": {
          "200": { "description": "Обновлённый тег", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Tag" } } } },
          "default": { "$ref": "#/components/responses/Error" }
        }
      },
      "delete": {
        "operationId": "deleteTag",
        "summary": "Удалить тег и связанный значок везде",
        "description": "Удаляет определение, все назначения и связанный значок у всех объектов. Не использовать для снятия тега с одной карточки.",
        "responses": {
          "200": { "description": "Удалено", "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean", "enum": [true] } }, "required": ["ok"] } } } },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/tags/relations": {
      "post": {
        "operationId": "assignTagRelations",
        "summary": "Добавить тег к объектам и статьям",
        "description": "Добавляет назначения без удаления остальных и без дубликатов. Оба массива обязательны, хотя бы один непустой. Тег со значком назначается только объектам, article_ids должен быть пуст. Проверяйте skipped: вторичный рынок, конфликт отопления, явно очищенная группа и лимит значков пропускаются. Неизвестные поля игнорируются. Снятие отдельных тегов не поддерживается.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TagRelationsCreate" } } } },
        "responses": {
          "200": { "description": "Итог назначения", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TagAssignmentSummary" } } } },
          "default": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/properties/{id}/description": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Идентификатор из ответа API, не slug",
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ],
      "patch": {
        "operationId": "setPropertyDescription",
        "summary": "Добавить или изменить описание объекта",
        "description": "Только обычный текст. Пустая строка очищает описание. Остальные поля объекта сохраняются; правка RF39 отмечается как ручная.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PropertyDescription"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Property"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "delete": {
        "operationId": "clearPropertyDescription",
        "summary": "Очистить описание, сохранив объект",
        "responses": {
          "200": {
            "description": "Успешный ответ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Property"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Серверный NUXT_AGENT_API_TOKEN: минимум 32 печатных ASCII-символа без пробелов. Передавайте секрет только в Authorization."
      }
    },
    "parameters": {
      "limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "offset": {
        "name": "offset",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "default": 0
        }
      },
      "q": {
        "name": "q",
        "in": "query",
        "schema": {
          "type": "string",
          "maxLength": 200
        }
      },
      "slug": {
        "name": "slug",
        "in": "query",
        "description": "Точное совпадение",
        "schema": {
          "type": "string",
          "maxLength": 150,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "published": {
        "name": "published",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "true",
            "false"
          ]
        }
      }
    },
    "responses": {
      "Error": {
        "description": "400: неверные поля; 401: неверный токен; 404: запись не найдена; 409: конфликт; 411: нет Content-Length; 413: превышен размер; 415: неверный Content-Type; 503: API выключен или не настроен.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "ArticleCreate": {
        "type": "object",
        "required": [
          "title",
          "slug",
          "excerpt",
          "content"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 150,
            "minLength": 3
          },
          "slug": {
            "type": "string",
            "maxLength": 150,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "excerpt": {
            "type": "string",
            "maxLength": 400,
            "minLength": 10
          },
          "content": {
            "type": "string",
            "maxLength": 50000,
            "description": "HTML очищается сервером; после очистки необходимо не менее 30 символов видимого текста. Также поддерживается ограниченный текстовый формат с абзацами, заголовками и списками."
          },
          "imageAlt": {
            "type": "string",
            "maxLength": 250,
            "default": ""
          },
          "seoTitle": {
            "type": "string",
            "maxLength": 150,
            "default": ""
          },
          "seoDescription": {
            "type": "string",
            "maxLength": 300,
            "default": ""
          },
          "seoKeywords": {
            "type": "string",
            "maxLength": 1000,
            "default": ""
          },
          "published": {
            "type": "boolean",
            "description": "false снимает публикацию и очищает расписание; true публикует сейчас либо в publishedAt.",
            "default": false
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "ISO 8601 с часовым поясом. Будущая дата планирует публикацию вместе с published:true."
          }
        }
      },
      "ArticlePatch": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 150,
            "minLength": 3
          },
          "slug": {
            "type": "string",
            "maxLength": 150,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "excerpt": {
            "type": "string",
            "maxLength": 400,
            "minLength": 10
          },
          "content": {
            "type": "string",
            "maxLength": 50000,
            "description": "HTML очищается сервером; после очистки необходимо не менее 30 символов видимого текста. Также поддерживается ограниченный текстовый формат с абзацами, заголовками и списками."
          },
          "imageAlt": {
            "type": "string",
            "maxLength": 250
          },
          "seoTitle": {
            "type": "string",
            "maxLength": 150
          },
          "seoDescription": {
            "type": "string",
            "maxLength": 300
          },
          "seoKeywords": {
            "type": "string",
            "maxLength": 1000
          },
          "published": {
            "type": "boolean",
            "description": "false снимает публикацию и очищает расписание; true публикует сейчас либо в publishedAt."
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "ISO 8601 с часовым поясом. Будущая дата планирует публикацию вместе с published:true."
          }
        }
      },
      "Article": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 150,
            "minLength": 3
          },
          "slug": {
            "type": "string",
            "maxLength": 150,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "excerpt": {
            "type": "string",
            "maxLength": 400,
            "minLength": 10
          },
          "content": {
            "type": "string",
            "maxLength": 50000,
            "description": "HTML очищается сервером; после очистки необходимо не менее 30 символов видимого текста. Также поддерживается ограниченный текстовый формат с абзацами, заголовками и списками."
          },
          "imageAlt": {
            "type": "string",
            "maxLength": 250
          },
          "seoTitle": {
            "type": "string",
            "maxLength": 150
          },
          "seoDescription": {
            "type": "string",
            "maxLength": 300
          },
          "seoKeywords": {
            "type": "string",
            "maxLength": 1000
          },
          "published": {
            "type": "boolean",
            "description": "false снимает публикацию и очищает расписание; true публикует сейчас либо в publishedAt."
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "ISO 8601 с часовым поясом. Будущая дата планирует публикацию вместе с published:true."
          },
          "id": {
            "type": "string"
          },
          "image": {
