          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "title",
          "slug",
          "excerpt",
          "content",
          "imageAlt",
          "seoTitle",
          "seoDescription",
          "seoKeywords",
          "published",
