generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Property {
  id          String          @id @default(cuid())
  title       String
  slug        String          @unique
  type        String
  housingMarket String?
  complexId   String?
  complex     Property?       @relation("ComplexApartments", fields: [complexId], references: [id], onDelete: SetNull)
  apartments  Property[]      @relation("ComplexApartments")
  nmarketComplexId String?
  rf39ComplexId String?
  rf39BuildingId String?
  location    String
  address     String          @default("")
  latitude    Float?
  longitude   Float?
  price       Int?
  status      String          @default("available")
  area        Float?
  landArea    Float?
  bedrooms    Int?
  floors      Int?
  availableFloors Int[]       @default([])
  layoutHash  String?
  readiness   String
  finish      String
  seaDistance Float?
  description String
  utilities   String[]
  published   Boolean         @default(false)
  featured    Boolean         @default(false)
  elite       Boolean         @default(false)
  demo        Boolean         @default(false)
  sourceId    String?          @unique
  sourceUrl   String?
  sourceName  String?
  sourceMode  String?
  sourceNote  String?
  sourceFetchedAt DateTime?
  rf39Baseline Json?
  developer   String?
  district    String?
  completionDate String?
  constructionStatus String?
  priceKind   String?
  priceSourceUrl String?
  priceArea   Float?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  images      PropertyImage[]
  leads       Lead[]
  importSources PropertyImportSource[]
  tagRelations TagRelation[]

  @@index([published, status])
  @@index([complexId])
  @@index([layoutHash])
}

model PropertyImportSource {
  sourceId     String   @id
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  apartmentKey String?
  price        Int?
  availableFloors Int[] @default([])

  @@index([propertyId])
  @@index([apartmentKey])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  file       String
  originalFile String?
  crop       Json?
  hueShift   Int      @default(0)
  alt        String
  kind       String   @default("photo")
  planRole   String?
  order      Int      @default(0)
  upscale    ImageUpscale?
}

model ImageUpscale {
  imageId    String        @id
  image      PropertyImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  sourceFile String
  outputFile String?
  mode       String
  status     String
  error      String?
  token      String?
  attempts   Int           @default(0)
  updatedAt  DateTime      @updatedAt

  @@index([status, updatedAt])
}

model ImportImageCache {
  url          String @id
  contentHash  String
  contentType  String
  originalFile String
  etag         String?
  lastModified String?
  checkedAt    DateTime @default(now())
  planFile     String?
  planHueShift Int?
  detectedPlan Boolean?
}

model ImageFingerprint {
  file      String @id
  signature String
  hash      String
}

model FeedSyncSetting {
  id             String @id @default("rf39")
  ownerId        String
  owner          AdminUser @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  url            String @default("https://feed.rf39.ru/30.xml")
  enabled        Boolean @default(false)
  intervalMinutes Int @default(60)
  nextRunAt      DateTime?
  lastSuccessAt  DateTime?
  lastError      String?
  lastJobId      String?
  updatedAt      DateTime @updatedAt
}

model Lead {
  id             String    @id @default(cuid())
  propertyId     String?
  property       Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  name           String
  phone          String
  comment        String    @default("")
  consent        Boolean
  consentVersion String    @default("2026-09-14")
  status         String    @default("new")
  createdAt      DateTime  @default(now())

  @@index([status, createdAt])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  sessions     Session[]
  importJobs   ImportJob[]
  feedSyncSettings FeedSyncSetting[]
}

model ImportJob {
  id             String   @id @default(cuid())
  ownerId        String
  owner          AdminUser @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  requestId      String
  kind           String
  request        Json
  status         String   @default("queued")
  stopRequested  Boolean  @default(false)
  activeTitle    String   @default("")
  total          Int      @default(0)
  processed      Int      @default(0)
  created        Int      @default(0)
  linked         Int      @default(0)
  existing       Int      @default(0)
  updated        Int      @default(0)
  unpublished    Int      @default(0)
  failed         Int      @default(0)
  error          String?
  token          String?
  leaseExpiresAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  finishedAt     DateTime?
  items          ImportJobItem[]

  @@unique([ownerId, requestId])
  @@index([status, leaseExpiresAt, createdAt])
}

model ImportJobItem {
  id           String   @id @default(cuid())
  jobId        String
  job          ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  key          String
  groupOrder   Int
  step         Int
  kind         String
  source       String
  title        String
  complexId    String?
  complexTitle String?
  payload      Json
  status       String   @default("queued")
  result       Json?
  error        String?
  updatedAt    DateTime @updatedAt

  @@unique([jobId, key])
  @@index([jobId, status, groupOrder, step])
}

model Session {
  id        String    @id
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}

model Article {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  excerpt        String
  content        String
  image          String    @default("")
  seoTitle       String    @default("")
  seoDescription String    @default("")
  published      Boolean   @default(false)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tagRelations   TagRelation[]

  @@index([published, publishedAt])
}

model Tag {
  id        String         @id @default(cuid())
  name      String         @unique
  relations TagRelation[]

  @@map("tags")
}

model TagRelation {
  id         String   @id @default(cuid())
  tagId      String   @map("tag_id")
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  propertyId String?  @map("property_id")
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  articleId  String?  @map("article_id")
  article    Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([tagId, propertyId])
  @@unique([tagId, articleId])
  @@index([propertyId])
  @@index([articleId])
  @@map("tags_relations")
}
