POSTGRES_PASSWORD=replace_with_a_long_random_url_safe_password
PORT=3100
ADMIN_EMAIL=admin@kvartirukupit.local
ADMIN_PASSWORD=replace_with_a_long_unique_password
COOKIE_SECURE=false
NUXT_PUBLIC_SITE_NAME=Квартирукупить
NUXT_PUBLIC_SITE_URL=http://localhost:3100
NUXT_PUBLIC_PHONE=
NUXT_PUBLIC_LEGAL_NAME=
NUXT_PUBLIC_LEGAL_ADDRESS=
NUXT_PUBLIC_LEGAL_EMAIL=
NUXT_PUBLIC_INN=
NUXT_MAP_SEARCH_URL=https://nominatim.openstreetmap.org/search
# Server-only API key for optional manual RF39 import:
NUXT_RF39_TOKEN=
# Full CRM catalog cache; Docker persists its own path in the rf39_snapshots volume:
NUXT_RF39_SNAPSHOT_PATH=.data/rf39/snapshot.json
# Server-only private XML feed URL for optional manual NMarket import:
NUXT_NMARKET_FEED_URL=
# Last complete download; Docker mounts .data/nmarket with write access:
NUXT_NMARKET_SNAPSHOT_PATH=.data/nmarket/snapshot.xml
# For local development against your own PostgreSQL:
# DATABASE_URL=postgresql://newh:password@localhost:5432/newh?schema=app
# UPLOAD_DIR=.data/uploads
